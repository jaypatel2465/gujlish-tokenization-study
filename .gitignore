# ─────────────────────────────────────────────────────────────────────────────
# Gujlish Tokenization Study — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace cache (re-downloaded automatically) ──
hf_cache/

# ── Model weights and training outputs (too large for GitHub) ──
# Tokenizer/config files under models/ ARE tracked; weights are not.
*.safetensors
*.bin
*.pt
models/classifiers/
models/mbert_obpe_base/
models/mbert_adapted_500/
out/
tmp_*/

# ── Raw / intermediate data (regenerated by scripts/phase1-3) ──
data/raw/
data/processed/filtered_dataset.csv
data/processed/word_frequencies.csv
data/processed/word_piece_counts.csv

# ── Regenerable / scratch outputs ──
results/classification/merged_predictions_wide.csv
results/predictions/smoke_*/

# ── Python cache ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Jupyter ──
.ipynb_checkpoints/

# ── Virtual environments ──
venv/
.venv/
env/
.env

# ── OS / IDE junk ──
.DS_Store
__MACOSX/
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace
